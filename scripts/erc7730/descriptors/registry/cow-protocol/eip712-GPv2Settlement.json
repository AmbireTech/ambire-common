  "display": {
    "formats": {
      "Order(address sellToken,address buyToken,address receiver,uint256 sellAmount,uint256 buyAmount,uint32 validTo,bytes32 appData,uint256 feeAmount,string kind,bool partiallyFillable,string sellTokenBalance,string buyTokenBalance)": {
        "intent": "Place CowSwap order",
        "fields": [
          {
            "path": "sellAmount",
            "label": "Sell amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "sellToken"
            },
            "visible": "always"
          },
          {
            "path": "buyAmount",
            "label": "Buy amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "buyToken"
            },
            "visible": "always"
          },
          {
            "path": "feeAmount",
            "label": "Fee",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "sellToken"
            },
            "visible": {
              "ifNotIn": ["0"]
            }
          },
          {
            "path": "receiver",
            "label": "To",
            "format": "addressName",
            "visible": "always"
          },
          {
            "path": "validTo",
            "label": "Valid until",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            },
            "visible": "always"
          },
          {
            "path": "kind",
            "label": "Order kind",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "partiallyFillable",
            "label": "Partially fillable",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "appData",
            "label": "App data",
            "visible": "never"
          },
          {
            "path": "sellTokenBalance",
            "label": "Sell token balance",
            "visible": "never"
          },
          {
            "path": "buyTokenBalance",
            "label": "Buy token balance",
            "visible": "never"
          }
        ]
      },
      "OrderCancellations(bytes[] orderUids)": {
        "intent": "Cancel CowSwap orders",
        "fields": [
          {
            "path": "orderUids[]",
            "label": "Order",
            "fields": [
              {
                "path": ".",
                "label": "Order ID",
                "format": "raw",
                "visible": "always"
              },
              {
                "path": ".[32:52]",
                "label": "Owner",
                "format": "addressName",
                "visible": "always"
              },
              {
                "path": ".[52:56]",
                "label": "Valid until",
                "format": "date",
                "params": {
