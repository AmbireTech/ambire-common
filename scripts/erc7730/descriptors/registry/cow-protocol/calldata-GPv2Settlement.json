      "setPreSignature(bytes orderUid,bool signed)": {
        "intent": "Pre-sign CowSwap order",
        "fields": [
          {
            "path": "orderUid",
            "label": "Order ID",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "orderUid.[32:52]",
            "label": "Owner",
            "format": "addressName",
            "visible": "always"
          },
          {
            "path": "orderUid.[52:56]",
            "label": "Valid until",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            },
            "visible": "always"
          },
          {
            "path": "signed",
            "label": "Pre-signature enabled",
            "format": "raw",
            "visible": "always"
          }
        ]
      },
